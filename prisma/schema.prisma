generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PLAYER
}

/// CUP is a tournament (has a champion); CASH is a cash game (no champion).
enum GameType {
  CUP
  CASH
}

enum TransactionKind {
  DEPOSIT
  WITHDRAW
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  /// Poker name shown everywhere in the app; the player can change it.
  displayName    String
  /// Playing motto, set by the player.
  motto          String?
  passwordHash   String
  role           Role     @default(PLAYER)
  /// Titles won before sessions recorded a champion (imported). Total crowns = this + championships.
  crowns         Int      @default(0)
  /// Cash-game profit carried over from before sessions were tracked, in cents. Counts toward cash profit, not per-session stats.
  openingBalance Int      @default(0)
  createdAt      DateTime @default(now())

  results             Result[]
  createdSessions     GameSession[] @relation("SessionCreator")
  championships       GameSession[] @relation("SessionChampion")
  transactions        Transaction[] @relation("TransactionUser")
  createdTransactions Transaction[] @relation("TransactionCreator")
  pokerNowAliases     PokerNowAlias[]
  heroHandLogs        HandLog[]     @relation("HandLogHero")
  uploadedHandLogs    HandLog[]     @relation("HandLogUploader")
}

/// One game: a cup (tournament) or a cash game.
model GameSession {
  id          String   @id @default(cuid())
  type        GameType @default(CUP)
  playedAt    DateTime @db.Date
  location    String?
  notes       String?
  createdAt   DateTime @default(now())
  createdById String
  /// Winner of the session, if any. Each one adds a crown to that player.
  championId  String?

  createdBy User     @relation("SessionCreator", fields: [createdById], references: [id])
  champion  User?    @relation("SessionChampion", fields: [championId], references: [id], onDelete: SetNull)
  results   Result[]
  handLog   HandLog?

  @@index([type, playedAt])
}

/// One player's result in one session. Amounts are integer cents; net = cashOut - buyIn.
model Result {
  id        String @id @default(cuid())
  sessionId String
  userId    String
  buyIn     Int
  cashOut   Int

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([userId])
}

/// Money moved in or out of the group's fund (kept by the treasurer). Not profit: it only changes the wallet.
/// Wallet (what a player can still withdraw) = profit + deposits - withdrawals.
model Transaction {
  id          String          @id @default(cuid())
  userId      String
  kind        TransactionKind
  /// Positive amount in cents.
  amount      Int
  happenedAt  DateTime        @db.Date
  note        String?
  createdAt   DateTime        @default(now())
  createdById String

  user      User @relation("TransactionUser", fields: [userId], references: [id])
  createdBy User @relation("TransactionCreator", fields: [createdById], references: [id])

  @@index([userId])
  @@index([happenedAt])
}

/// A Poker Now account (the id after " @ " in the log) linked to a player, remembered for later imports.
model PokerNowAlias {
  pokerNowId String @id
  userId     String
  /// Name the account used in the latest imported log.
  lastName   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A Poker Now hand log imported into a game (one per game; importing again replaces it).
model HandLog {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  /// Poker Now id of whoever downloaded the log: their hole cards appear in every hand (Hand.heroCards).
  heroPokerNowId String?
  /// The player behind heroPokerNowId. Only they and admins may see Hand.heroCards.
  heroUserId     String?
  /// Every Poker Now player in the log: { [pokerNowId]: { name, userId | null } }.
  players        Json
  /// Playing-style counters per Poker Now id (src/lib/pokernow/stats.ts PlayStats), computed on import.
  stats          Json?
  uploadedById   String
  createdAt      DateTime @default(now())

  session    GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  heroUser   User?       @relation("HandLogHero", fields: [heroUserId], references: [id], onDelete: SetNull)
  uploadedBy User        @relation("HandLogUploader", fields: [uploadedById], references: [id])
  hands      Hand[]
}

/// One hand from a HandLog. Chip amounts, not cents.
model Hand {
  id         String   @id @default(cuid())
  logId      String
  number     Int
  /// Poker Now's hand id; unique so the same log can't be imported into two games.
  pokerNowId String   @unique
  startedAt  DateTime
  /// Total chips collected.
  pot        Int
  showdown   Boolean
  /// The log owner's hole cards, kept out of `data` so pages can leave them out for other viewers.
  heroCards  String[]
  /// The parsed hand (src/lib/pokernow/parse.ts ParsedHand) without heroCards.
  data       Json

  log HandLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@unique([logId, number])
}
