generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PLAYER
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  /// Poker name shown everywhere in the app; the player can change it.
  displayName    String
  /// Playing motto, set by the player.
  motto          String?
  passwordHash   String
  role           Role     @default(PLAYER)
  /// Titles won before sessions recorded a champion (imported). Total crowns = this + championships.
  crowns         Int      @default(0)
  /// Profit carried over from before sessions were tracked, in cents. Counts toward net, not per-session stats.
  openingBalance Int      @default(0)
  createdAt      DateTime @default(now())

  results         Result[]
  createdSessions GameSession[] @relation("SessionCreator")
  championships   GameSession[] @relation("SessionChampion")
}

/// One night of poker.
model GameSession {
  id          String   @id @default(cuid())
  playedAt    DateTime @db.Date
  location    String?
  notes       String?
  createdAt   DateTime @default(now())
  createdById String
  /// Winner of the session, if any. Each one adds a crown to that player.
  championId  String?

  createdBy User     @relation("SessionCreator", fields: [createdById], references: [id])
  champion  User?    @relation("SessionChampion", fields: [championId], references: [id], onDelete: SetNull)
  results   Result[]

  @@index([playedAt])
}

/// One player's result in one session. Amounts are integer cents; net = cashOut - buyIn.
model Result {
  id        String @id @default(cuid())
  sessionId String
  userId    String
  buyIn     Int
  cashOut   Int

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([userId])
}
