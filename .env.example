# Postgres connection string (Neon, or local Postgres)
DATABASE_URL="postgresql://poker:poker@localhost:5432/poker"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# First admin account, created by `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_DISPLAY_NAME="Admin"

# Starting password for players created by `npm run db:import` (real history, maintainers only)
IMPORT_DEFAULT_PASSWORD=""
